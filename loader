local setEsp, setNoclip
do
	local LocalPlayer = Players.LocalPlayer
	local ESP_COLOR = Color3.fromRGB(125, 211, 252) -- Kuro cyan

	local espFolder = Instance.new("Folder")
	espFolder.Name = "KuroESP"
	espFolder.Parent = parent

	local espEnabled = false
	local espObjects = {}

	local function removeEsp(plr)
		local o = espObjects[plr]
		if o then
			pcall(function()
				o.highlight:Destroy()
				o.billboard:Destroy()
			end)
			espObjects[plr] = nil
		end
	end

	local function applyEsp(plr)
		if not espEnabled or plr == LocalPlayer then return end
		local char = plr.Character
		if not char then return end
		local root = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 5)
		if not root or not espEnabled then return end
		removeEsp(plr)

		local hl = Instance.new("Highlight")
		hl.Name = "KuroESPHighlight"
		hl.Adornee = char
		hl.FillColor = ESP_COLOR
		hl.FillTransparency = 0.6
		hl.OutlineColor = Color3.new(1, 1, 1)
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Parent = espFolder

		local bb = Instance.new("BillboardGui")
		bb.Name = "KuroESPLabel"
		bb.Adornee = root
		bb.AlwaysOnTop = true
		bb.Size = UDim2.fromOffset(140, 20)
		bb.StudsOffset = Vector3.new(0, 3.5, 0)
		bb.Parent = espFolder

		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.fromScale(1, 1)
		lbl.BackgroundTransparency = 1
		lbl.Text = plr.Name
		lbl.TextColor3 = ESP_COLOR
		lbl.TextStrokeTransparency = 0.3
		lbl.Font = Enum.Font.GothamBold
		lbl.TextSize = 13
		lbl.Parent = bb

		espObjects[plr] = { highlight = hl, billboard = bb, label = lbl }
	end

	local function trackPlayer(plr)
		if plr == LocalPlayer then return end
		plr.CharacterAdded:Connect(function() task.spawn(applyEsp, plr) end)
	end

	for _, plr in ipairs(Players:GetPlayers()) do trackPlayer(plr) end
	Players.PlayerAdded:Connect(trackPlayer)
	Players.PlayerRemoving:Connect(removeEsp)

	setEsp = function(v)
		espEnabled = v
		if v then
			for _, plr in ipairs(Players:GetPlayers()) do task.spawn(applyEsp, plr) end
		else
			for plr in pairs(espObjects) do removeEsp(plr) end
		end
	end

	task.spawn(function()
		while alive() do
			task.wait(0.25)
			if espEnabled then
				local myChar = LocalPlayer.Character
				local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
				for plr, o in pairs(espObjects) do
					local char = plr.Character
					local root = char and char:FindFirstChild("HumanoidRootPart")
					if myRoot and root then
						o.label.Text = plr.Name .. " [" .. math.floor((root.Position - myRoot.Position).Magnitude) .. "m]"
					end
				end
			end
		end
	end)

	local noclipConn = nil
	local noclipParts = {}

	setNoclip = function(v)
		if v then
			if noclipConn then return end
			noclipConn = RunService.Stepped:Connect(function()
				local char = LocalPlayer.Character
				if not char then return end
				for _, part in ipairs(char:GetDescendants()) do
					if part:IsA("BasePart") and part.CanCollide then
						noclipParts[part] = true
						part.CanCollide = false
					end
				end
			end)
		else
			if noclipConn then
				noclipConn:Disconnect()
				noclipConn = nil
			end
			for part in pairs(noclipParts) do
				if part.Parent then part.CanCollide = true end
			end
			noclipParts = {}
		end
	end
end

