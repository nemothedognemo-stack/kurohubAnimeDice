						pcall(function() inst.Enabled = false end)
					end
				end
			end
		else
			if oldGraphics.shadows ~= nil then pcall(function() lighting.GlobalShadows = oldGraphics.shadows end) end
			for _, item in ipairs(oldGraphics.effects or {}) do
				if item.instance and item.instance.Parent then
					pcall(function() item.instance.Enabled = item.enabled end)
				end
			end
			oldGraphics = {}
		end
	end
	local function applyBoost(enabled)
		statsGui.Enabled = enabled
		setLowGraphics(enabled)
		black.Visible = enabled
		local ok, err = pcall(function() RunService:Set3dRenderingEnabled(not enabled) end)
		if not ok then warn("[Kuro] FPS Boost: " .. tostring(err)) end
		if enabled then display() end
	end
	disableFromStats = function()
		if type(env.KuroSetFpsBoostOff) == "function" then
			env.KuroSetFpsBoostOff()
		else
			state.fpsBoost = false
			applyBoost(false)
			saveSettings()
		end
	end
	return applyBoost
end
