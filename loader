		local enabled = state.autoJoinEvent and not (state.autoJoinDailyChallenge and dailyChallenge.canJoin())
		if not enabled then
			requested = false
			busy = false
			retryAt = 0
			attempts = 0
		elseif not wasEnabled then
			requested = false
			retryAt = 0
			attempts = 0
		end
		wasEnabled = enabled

		if enabled and not matchEnding and not requested and not busy and os.clock() >= retryAt and attempts < 3 then
			requested = true
			busy = true
			attempts = attempts + 1

			task.spawn(function()
				local ep = ReplicatedStorage:FindFirstChild("endpoints")
				local folder = ep and ep:FindFirstChild("client_to_server")
				local remote = folder and folder:FindFirstChild("request_matchmaking")
