local function queueSelf()
	if state.autoExecTeleport and type(queueFn) == "function" then
		-- Once per run: toggle init + GUI callbacks would otherwise stack copies
		if env.KuroQueuedRun == RUN_ID then return end
		env.KuroQueuedRun = RUN_ID
		local ok, err = pcall(queueFn, buildQueuedCode())
		if not ok then
			env.KuroQueuedRun = nil
			warn("[Kuro] Could not queue teleport script: " .. tostring(err))
		end
	end
end

local function setAutoExecTeleport(v)
	if v then
		queueSelf()
	elseif type(clearQueueFn) == "function" then
		pcall(clearQueueFn)
		env.KuroQueuedRun = nil
	end
end

